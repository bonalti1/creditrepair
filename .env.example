# Supabase (Postgres / Auth / RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API — letter wording variation + AI Credit Coach + AI intake (reading
# report PDFs, checking ID / proof of address, bureau letters; docs/INTAKE.md).
# Without it intake returns labelled simulated results and, with a database,
# sends every document to a person.
ANTHROPIC_API_KEY=
# Optional: the model AI intake uses (default claude-opus-5-5).
INTAKE_MODEL=
# Optional: the model Alti's (the AI assistant's) drafted replies for staff use (default claude-opus-5-5; docs/STAFF.md).
# Without ANTHROPIC_API_KEY there are no drafts; saved answers still work.
DRAFT_MODEL=

# Lob — letter printing and mailing. Without a key nothing is mailed ("simulado").
LOB_API_KEY=
# The secret of the Lob webhook (Lob dashboard → Webhooks → your webhook) that
# posts tracking events to /api/webhooks/lob. Without it that endpoint refuses
# every delivery.
LOB_WEBHOOK_SECRET=
# Letters: with a database, a round is mailed (or printed) only when every
# letter it uses has an attorney-approved version in /equipo/cartas
# (docs/LETTERS-EDITOR.md). 1 lets unapproved letters go: ONLY for testing with
# Lob's test key, never with real clients. Leave empty.
LETTERS_ALLOW_UNAPPROVED=

# WhatsApp Cloud API — status updates + day-40 re-engagement
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta app secret (App settings → Basic). Required once WhatsApp is live: the
# inbound webhook rejects any delivery not signed with it.
WHATSAPP_APP_SECRET=
# Piloto automático (docs/AUTOPILOT.md). The WhatsApp message templates Meta
# approved, by name, comma-separated. Outside the client's 24-hour window an
# automatic message goes on WhatsApp only as an approved template.
WHATSAPP_APPROVED_TEMPLATES=
# Email for automatic messages (a transactional email API; Resend's request
# shape by default, EMAIL_API_URL to point elsewhere). Email is on only when
# all of these AND NEXT_PUBLIC_COMPANY_ADDRESS and NEXT_PUBLIC_APP_URL are set:
# every automatic email carries an unsubscribe link and the postal address.
# Never SMS for automatic messages: text messages are for login codes only.
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_API_URL=
# A long random value that signs the unsubscribe links.
UNSUBSCRIBE_SECRET=

# Monitoring provider. Decision: IdentityIQ (see docs/IDENTITYIQ.md).
# MONITORING_PROVIDER: "demo" until IDIQ report access exists, then "identityiq".
MONITORING_PROVIDER=
MONITORING_API_KEY=
MONITORING_API_BASE_URL=
# The partner signup link IDIQ issues. Setting it switches the pages from
# "monitoreo de crédito" to naming IdentityIQ and shows the subscribe button.
NEXT_PUBLIC_MONITORING_SIGNUP_URL=
# Price shown to customers. Must match the checkout page the link leads to.
# Default "~$32" (Secure Max list price was $31.49/month on 2026-11-19).
NEXT_PUBLIC_MONITORING_PRICE=

# Stripe — not needed with IdentityIQ: the customer pays IdentityIQ directly.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# n8n webhook shared secret (round triggers, pull scheduling, /api/cron/rounds)
N8N_WEBHOOK_SECRET=

# Sales comes first on WhatsApp: a number with no customer profile is a lead.
# The AI assistant (Alti; the name is BRAND.assistant in src/lib/brand.ts) greets a lead once and leaves the thread to a person. "ai" lets it
# answer leads as well. SALES_WEBHOOK_URL (Slack or n8n, {"text": ...}) gets a
# ping for each new lead.
WHATSAPP_LEAD_REPLIES=
SALES_WEBHOOK_URL=

# ── HighLevel (docs/HIGHLEVEL.md) ─────────────────────────────────────────
# The shared secret the HighLevel workflow sends in the "x-credalti-secret"
# header (or as "Authorization: Bearer <secret>") to /api/webhooks/highlevel.
# Long and random (openssl rand -hex 32). Without it the endpoint refuses every lead.
HIGHLEVEL_WEBHOOK_SECRET=
# The URL of the HighLevel workflow's "Inbound Webhook" trigger that receives
# stage changes from /api/cron/highlevel. Falls back to SALES_WEBHOOK_URL.
# https only. The payload carries a contact id, phone, stage and date; never credit data.
HIGHLEVEL_INBOUND_WEBHOOK_URL=

# ── Referral partners (docs/PARTNERS.md) ──────────────────────────────────
# Where a partner's link (/r/<code>) lands. Empty: this app's landing page.
# Set to a HighLevel funnel (https) to have the code arrive as ?socio=<code>.
PARTNER_LANDING_URL=

# Error alerts. Any webhook that accepts {"text": "..."} — a Slack incoming
# webhook, or an n8n webhook that forwards to WhatsApp. Leave empty to log only.
ERROR_WEBHOOK_URL=

# Public app URL — used for WhatsApp deep links back into the journey
NEXT_PUBLIC_APP_URL=

# The public website's origin (canonical links, hreflang, sitemap, robots, Open
# Graph). Defaults to NEXT_PUBLIC_APP_URL. No trailing slash. docs/WEBSITE.md.
NEXT_PUBLIC_SITE_URL=

# WhatsApp number for the funnel CTA and Plan Asistido (digits only, e.g. 15551234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# How the service is delivered is chosen PER CLIENT (docs/SERVICE-OPTIONS.md):
# Credalti Complete (the team prepares and mails) or Credalti DIY (Alti
# prepares, the client prints and mails). The old NEXT_PUBLIC_SERVICE_MODE
# switch is retired. Credalti DIY has its own agreement text and version: set
# this to that version (shown on /acuerdo/copia for a DIY client) only after
# the attorney approves it. Until then no one can sign Credalti DIY.
NEXT_PUBLIC_DIY_AGREEMENT_APPROVED_VERSION=

# ── Service agreement (docs/AGREEMENT.md) ────────────────────────────────
# The facts printed in the contract a client signs. They are public by nature
# (the client reads them), so they are NEXT_PUBLIC_. Until every one is set the
# contract shows a placeholder in its place and no real client can sign.
NEXT_PUBLIC_COMPANY_LEGAL_NAME=
# Principal business address, one line: "100 Main St, Suite 200, Houston, TX 77002"
NEXT_PUBLIC_COMPANY_ADDRESS=
# Where a client writes to cancel, ask for a paper copy or withdraw consent.
NEXT_PUBLIC_COMPANY_EMAIL=
# Optional.
NEXT_PUBLIC_COMPANY_PHONE=
# Monthly fee in dollars ("89" or "89.00") and the estimated length in months.
NEXT_PUBLIC_PLAN_MONTHLY_FEE=
NEXT_PUBLIC_PLAN_ESTIMATED_MONTHS=
# Texas credit services organization registration (Secretary of State) and bond.
NEXT_PUBLIC_TX_CSO_REGISTRATION_NUMBER=
NEXT_PUBLIC_TX_BOND_SURETY_NAME=
NEXT_PUBLIC_TX_BOND_SURETY_ADDRESS=
# The agent in Texas authorized to receive service of process.
NEXT_PUBLIC_TX_AGENT_NAME=
NEXT_PUBLIC_TX_AGENT_ADDRESS=
# Set to the exact AGREEMENT_VERSION (src/lib/agreement/documents.ts) ONLY after
# an attorney has approved that version of the text. Leave empty until then:
# with a database configured, nobody can sign while it is empty or different.
NEXT_PUBLIC_AGREEMENT_APPROVED_VERSION=
# Optional. A webhook ({"text": ...}) told when a client cancels or asks to end
# the service. Falls back to SALES_WEBHOOK_URL.
TEAM_WEBHOOK_URL=

# Feature flags. ABA handoff ships dark until attorney sign-off (spec §5/Phase 6).
NEXT_PUBLIC_FEATURE_ABA_HANDOFF=0

# "Schedule a call with a person" (docs/SIGNUP-CHAT.md). Built and OFF: leave
# empty until the attorney answers the Telemarketing Sales Rule question in
# docs/SALES-FLOW.md. "1" turns on the booking page (/registro/llamada), the
# option in the chat signup and the console's Calls screen. Calls are for
# questions only; nothing is sold or paid on a call.
NEXT_PUBLIC_CALLS_ENABLED=

# An instant soft credit pull for the chat signup's "Your report" step
# (src/lib/credit/softPull.ts). "none" (the default): no provider is
# connected and the step uses the monitoring subscription.
SOFT_PULL_PROVIDER=none

# ── Billing (docs/BILLING.md) ─────────────────────────────────────────────
# The payment processor: "nmi", "authorize_net" or "demo". Empty = nothing is
# ever charged. "demo" moves no money. Adapters: src/lib/billing/gateways/.
BILLING_GATEWAY=
# Set to the exact PAYMENT_AUTHORIZATION_VERSION (src/lib/billing/authorization.ts)
# ONLY after an attorney approved that version of the recurring-payment
# authorization. Until then no real client can put a payment method on file.
NEXT_PUBLIC_PAYMENT_AUTHORIZATION_APPROVED_VERSION=
# The same for the ACH (bank debit) authorization: the exact ACH_AUTHORIZATION_VERSION
# (src/lib/billing/achAuthorization.ts), only after an attorney approved it.
NEXT_PUBLIC_ACH_AUTHORIZATION_APPROVED_VERSION=

# NMI (BILLING_GATEWAY=nmi). The security key is secret (server only); the
# tokenization key is public and only makes Collect.js tokens. Never commit values.
NMI_SECURITY_KEY=
NEXT_PUBLIC_NMI_TOKENIZATION_KEY=
# Webhook signing key, from NMI's merchant portal (webhooks settings).
NMI_WEBHOOK_SIGNING_KEY=
# Optional overrides of the API endpoints (defaults in gateways/nmi.ts).
NMI_API_URL=
NMI_QUERY_URL=

# Authorize.Net (BILLING_GATEWAY=authorize_net). Login ID and transaction key are
# secret; the client key and the public login ID go to AcceptUI in the browser.
AUTHORIZE_NET_API_LOGIN_ID=
AUTHORIZE_NET_TRANSACTION_KEY=
NEXT_PUBLIC_AUTHORIZE_NET_API_LOGIN_ID=
NEXT_PUBLIC_AUTHORIZE_NET_CLIENT_KEY=
# Webhook signature key (Account > Settings > API Credentials & Keys).
AUTHORIZE_NET_SIGNATURE_KEY=
# "production" for live money; anything else is the sandbox.
AUTHORIZE_NET_ENV=

# Processing fee ESTIMATES for the dashboard and the CSV files (not secrets).
# Basis points and cents. Defaults: card 390 bps + 30¢; ACH 100 bps + 30¢, capped at 500¢.
NEXT_PUBLIC_BILLING_FEE_CARD_BPS=
NEXT_PUBLIC_BILLING_FEE_CARD_FIXED_CENTS=
NEXT_PUBLIC_BILLING_FEE_ACH_BPS=
NEXT_PUBLIC_BILLING_FEE_ACH_FIXED_CENTS=
NEXT_PUBLIC_BILLING_FEE_ACH_CAP_CENTS=

# Credalti Control (docs/CONTROL.md). Staff phone alerts by web push: without
# these three nothing is pushed (the in-app list still works). Make a pair with
#   npx tsx -e "import('./src/lib/push/webPush.ts').then(m => console.log(m.generateVapidKeys()))"
# The private key is secret (server only). VAPID_SUBJECT: mailto:you@yourdomain or an https URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Read lead conversations from HighLevel's Conversations API (read only). OFF unless
# LEAD_CONVERSATIONS_PROVIDER=highlevel and both values below are set.
LEAD_CONVERSATIONS_PROVIDER=
HIGHLEVEL_API_TOKEN=
HIGHLEVEL_LOCATION_ID=
# Content hub publishing (docs/CONTENT.md, "Connecting the accounts"). All off
# unless set; publishing also has its own on/off switch in /equipo/contenido/publicar
# (off by default). CONTENT_TOKEN_KEY encrypts the social tokens at rest
# (32 bytes, base64 or hex: `openssl rand -base64 32`). Never commit values.
CONTENT_TOKEN_KEY=
# Meta (Facebook Page + Instagram Business). META_PAGE_ID picks the Page when the account manages several.
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
# TikTok Content Posting API. "true" only after TikTok's audit: until then posts are private.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_AUDITED=
# YouTube Data API v3 (a Google OAuth client).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Optional: the model Alti's writing assistant uses (default claude-opus-5-5).
CONTENT_MODEL=
# The Ads Manager (docs/ADS.md): Meta ads, READ ONLY. Both off until set; without
# them /equipo/anuncios says Meta is not connected and the demo shows sample data.
# A System User token (Business Settings → Users → System users) from the same Meta
# app as META_APP_ID, with the ads_read permission only (it can never change an ad).
# Server only: never in the browser, never in a URL. META_APP_SECRET above, when set,
# adds appsecret_proof to every call. META_AD_ACCOUNT_ID: "act_1234567890" or the number.
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Optional: the Graph API version for the ads calls (default v21.0, like content publishing).
META_GRAPH_VERSION=
# Ideas (docs/IDEAS.md). Optional: the model «Ask Alti for ideas» uses (default
# claude-opus-5-5). Without ANTHROPIC_API_KEY the button says Alti is not connected.
IDEAS_MODEL=

# SEO (docs/SEO.md): Google Search Console, READ ONLY. The site, plus either a
# service account (recommended: CLIENT_EMAIL + PRIVATE_KEY, the key with \n for
# line breaks) or an OAuth client (CLIENT_ID + CLIENT_SECRET + REFRESH_TOKEN).
# Server only. Without them /equipo/seo shows a «Connect» card.
GOOGLE_SEARCH_CONSOLE_SITE=
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=

# Video Studio (docs/VIDEO.md): automatic captions, off until set. Only a clip's
# sound goes to the provider. TRANSCRIBE_PROVIDER=openai is the one written so
# far; TRANSCRIBE_MODEL and TRANSCRIBE_API_URL are optional overrides.
TRANSCRIBE_API_KEY=
TRANSCRIBE_PROVIDER=
TRANSCRIBE_MODEL=
TRANSCRIBE_API_URL=
